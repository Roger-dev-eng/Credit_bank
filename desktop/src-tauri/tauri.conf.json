{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Gestão de Crédito",
  "version": "0.3.0",
  "identifier": "app.credito.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev",
    "beforeBuildCommand": "npm --prefix ../frontend run build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Gestão de Crédito",
        "width": 1350,
        "height": 880,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png"
    ],
    "resources": [
      "resources/**/*"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "offlineInstaller"
      },
      "nsis": {
        "compression": "zlib",
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR"
        ],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "sidebarImage": "installer/sidebar.bmp",
        "headerImage": "installer/header.bmp",
        "uninstallerHeaderImage": "installer/header.bmp",
        "installerHooks": "installer/appearance.nsh",
        "template": "installer/template.nsi"
      },
      "allowDowngrades": false
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "windows": {
        "installMode": "passive"
      },
      "endpoints": [
        "https://github.com/Roger-dev-eng/Credit_bank/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4NjI3NTY3MTEzMDZDMDYKUldRR2JEQVJaM1ZpU0RvYXpDR0FyeU1jY3ZvMnd2OXdwVDVGNTdXdVNLRlRzOS9LYmltWVNWZzcK",
      "requireSignedVersion": true
    }
  }
}
